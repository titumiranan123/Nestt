    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "prisma": "^6",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
