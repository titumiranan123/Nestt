  "type": "module",
  "scripts": {
    "prebuild": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:seed:roles": "node --experimental-strip-types prisma/seed-roles.ts",
    "prisma:seed:permissions": "node --experimental-strip-types prisma/seed-permissions.ts",
    "prisma:seed:product-categories": "node --experimental-strip-types prisma/seed-product-categories.ts",
    "prisma:seed:product-attributes": "node --experimental-strip-types prisma/seed-product-attributes.ts",
    "prisma:seed:products": "node --experimental-strip-types prisma/seed-products.ts",
    "prisma:seed:bangladesh-locations": "node --experimental-strip-types prisma/seed-bangladesh-locations.ts",
    "prisma:seed:seo": "node --experimental-strip-types prisma/seed-seo.ts",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
